{
  "manifest_version": 3,
  "name": "Focus Tube - Distraction Blocker",
  "version": "2.0.3",
  "description": "Transform YouTube into a productivity tool. Block Shorts, autoplay, suggestions, and more. Stay focused on what matters.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://www.youtube.com/youtubei/v1/player*",
    "https://www.youtube.com/watch*",
    "https://api.mymemory.translated.net/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*",
    "https://grok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["blocker.css"],
      "js": ["content_script.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Focus Tube"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
