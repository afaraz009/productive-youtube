{
  "name": "productive-youtube",
  "version": "2.0.3",
  "description": "Transform YouTube into a productivity tool - Block distractions and stay focused",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/post-build.mjs",
    "preview": "vite preview",
    "watch": "vite build --watch",
    "clean": "rimraf dist",
    "copy-files": "node scripts/post-build.mjs",
    "package": "npm run build && zip -r extension.zip dist/*"
  },
  "dependencies": {
    "lucide": "^0.556.0",
    "lucide-react": "^0.552.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.254",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "rimraf": "^5.0.5",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
